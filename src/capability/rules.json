            "chatgpt-4o",
            "flash",
            "gpt-4-turbo",
            "gpt-4.1",
            "gpt-4o",
            "gpt-5",
            "kimi",
            "o4",
            "omni",
            "qwen3.6-35b",
            "qvq",
            "vision",
            "vl"
          ],
          "include": ["^glm[-\\d.]*\\dv", "^glm-5\\.3-flash"]
        },
        "audio": { "keywords": ["audio", "realtime"] },
        "video": { "default": false }
      },
      "output": {
        "text": { "default": true, "exclude": ["^(dall-e|gpt-image|tts|sora)"] },
        "image": { "include": ["^(dall-e|gpt-image)"] },
        "audio": { "include": ["^tts"], "keywords": ["realtime"] },
        "video": { "include": ["^sora"] }
