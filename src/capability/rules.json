      "abilities": {
        "thinking": { "include": ["^(o\\d|gpt-5)"] },
        "tools": {
          "keywords": ["chatgpt", "gpt"],
          "include": ["^o[34]"],
          "exclude": ["^gpt-image"]
        },
        "embedding": { "keywords": ["embedding"] },
        "decision": { "default": false }
      }
    },
    "deepseek": {
