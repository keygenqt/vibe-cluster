      },
      "output": {
        "text": {
          "default": true,
          "exclude": ["^wanx", "^wan\\d", "cosyvoice", "qwen-tts", "qwen-image"]
        },
        "image": { "include": ["^wanx"], "keywords": ["qwen-image"] },
        "audio": { "keywords": ["cosyvoice", "qwen-tts"] },
        "video": { "include": ["^wan\\d"] }
      },
      "abilities": {
        "thinking": { "keywords": ["thinking"], "include": ["^qwen3"] },
