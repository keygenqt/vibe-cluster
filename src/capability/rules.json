          "keywords": [
            "bakllava",
            "gemma3",
            "glm-5.3-flash",
            "llava",
            "minicpm-v",
            "moondream",
            "omni",
            "vision",
            "vl"
          ],
          "include": ["glm.*\\dv"]
        },
        "audio": { "keywords": ["omni"] },
        "video": { "keywords": ["omni"] }
      },
      "output": {
        "text": { "default": true, "exclude": ["embed", "bge"] },
        "image": { "default": false },
        "audio": { "default": false },
        "video": { "default": false }
      },
      "abilities": {
        "tools": { "keywords": ["qwen", "llama", "mistral", "glm"] },
        "thinking": { "keywords": ["thinking", "qwq", "r1"] },
        "embedding": { "keywords": ["embed", "bge"] },
        "decision": { "default": false }
      }
    },
    "openai": {
